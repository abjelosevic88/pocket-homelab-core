TZ=Europe/Berlin
BASE_URL=https://core.example.com
SECURE_COOKIES=true
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=change-me-please
# REGISTRATION_KEY=pcreg_choose-something-long
# OIDC_ISSUER=https://core.example.com     # defaults to BASE_URL
# PAIR_TTL=10m
# HEALTH_INTERVAL=60s
# EVENT_RETENTION=720h
# WEBHOOK_ATTEMPTS=8
# Account MCP sign-in (requires HTTPS BASE_URL and local password/SSO authentication):
MCP_OAUTH_ENABLED=false
# Curated per-user read/create/update tools (requires OAuth; explicit consent):
MCP_APP_TOOLS_ENABLED=false
# Operator credentials: build this revision, run `pocket-core mcp setup`, then use docker-compose.mcp.yml.
# Native deployments set MCP_CLIENTS_FILE=/absolute/path/to/mcp-secrets/server/clients.json.
# Alternatively, use a single environment credential (no automatic expiry):
# MCP_TOKEN_HASH=<64-character SHA-256 digest>
# MCP_APPS=notes,tasks
