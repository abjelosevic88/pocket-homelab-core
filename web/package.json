{
  "name": "pocket-core-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && npm run build:ask",
    "preview": "vite preview",
    "build:ask": "esbuild src/ask/markdown.ts --bundle --format=iife --target=es2022 --minify --outfile=dist/ask-markdown.js",
    "test:ask": "npm run build:ask && playwright test --config=playwright.ask.config.ts"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "marked": "^18.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
